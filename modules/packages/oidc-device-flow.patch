+// Self-hosted sign-in (logseq-flake patch, oidc-device-flow.patch): the OAuth
+// 2.0 Device Authorization Grant (RFC 8628) against https://<oauthDomain>,
+// instead of Cognito's own API. The actual login (password, MFA, brokering,
+// sign-up) happens on the IdP's own page in a real browser, so the same code
+// serves web, desktop and mobile with no redirect handling. Paths follow the
+// /oauth2/token convention the client's refresh already hardcodes
+// (src/main/frontend/handler/user.cljs), so the IdP needs one more rewrite of
+// the same kind: /oauth2/device -> its device authorization endpoint.
+async function oauthPost(endpoint: string, params: Record<string, string>) {
+  const res = await fetch(`https://${authConfig.oauthDomain}/oauth2/${endpoint}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams({ client_id: authConfig.userPoolClientId, ...params })
+  })
+  return { ok: res.ok, body: await res.json() }
+}
+
+function jwtClaims(jwt: string) {
+  const b64 = jwt.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')
+  return JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(b64), c => c.charCodeAt(0))))
+}
