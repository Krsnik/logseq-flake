# Deployment config, Twelve-Factor style: copy to `.env` and fill in.
#
#   docker compose: a .env beside ./docker-compose.yml is read automatically.
#   nix run path:.#logseq-webapp: reads a .env in the current directory.
#   docker run: --env-file .env
#
# Variables already set in the shell win over the file, in both cases.
# Every key the web app reads is in ../modules/packages/_client-config.nix.

# The OIDC provider, for the servers and the web app's sign-in alike.
LOGSEQ_OIDC_ISSUER=https://idp.example.org/realms/logseq
LOGSEQ_OIDC_CLIENT_ID=logseq
# Servers only: where they fetch the provider's signing keys.
LOGSEQ_OIDC_JWKS_URL=https://idp.example.org/realms/logseq/protocol/openid-connect/certs

# Where the web app itself is reachable: it answers the client's user_info call.
# A bare host: the client always prepends https://.
LOGSEQ_API_DOMAIN=notes.example.org
# Full URLs, the same form as the Settings fields users can override them in.
LOGSEQ_SYNC_URL=https://sync.example.org
LOGSEQ_PUBLISH_URL=https://blog.example.org
